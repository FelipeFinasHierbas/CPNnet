{
  "name": "cpnnet/asistente",
  "description": "Asistente comercial de CPNnet Security para WordPress",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=8.1",
    "anthropic-ai/sdk": "^0.54",
    "guzzlehttp/guzzle": "^7.8"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": { "php-http/discovery": false }
  }
}
